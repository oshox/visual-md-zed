interface visual-md {
    use common.{range};

    /// How a run of text is styled.
    ///
    /// Colors are hex strings (`#rgb`, `#rgba`, `#rrggbb` or `#rrggbbaa`). A
    /// color that does not parse is ignored.
    record span-style {
        /// The text color.
        color: option<string>,
        /// The background color.
        background-color: option<string>,
        /// The name of a theme syntax token, such as `keyword` or
        /// `visual_md.link`, to take colors from. Explicit colors win.
        theme-token: option<string>,
        /// The font weight, from 100 to 900.
        font-weight: option<u16>,
        /// Whether the text is italic.
        italic: option<bool>,
        /// Whether the text is underlined.
        underline: option<bool>,
        /// Whether the text is struck through.
        strikethrough: option<bool>,
    }

    /// A style applied to a range of text.
    record styled-span {
        /// The range the style covers, in UTF-8 bytes of the text it belongs to.
        range: range,
        /// The style to apply.
        style: span-style,
    }

    /// Text with styles applied to ranges of it.
    record styled-text {
        /// The text.
        text: string,
        /// The styles, in UTF-8 byte offsets into `text`.
        spans: list<styled-span>,
    }

    /// The format of an image.
    enum image-format {
        png,
        jpeg,
        gif,
        webp,
    }

    /// An encoded image.
    record image {
        /// The format `bytes` is encoded in.
        format: image-format,
        /// The encoded image.
        bytes: list<u8>,
    }

    /// What a fenced code block renderer produces, shown in place of the block.
    variant fence-output {
        /// Styled text, shown in the code font.
        styled-text(styled-text),
        /// Markdown, rendered with the editor's Markdown renderer.
        markdown(string),
        /// An SVG document.
        svg(string),
        /// An encoded raster image.
        image(image),
    }

    /// Whether the active theme is light or dark.
    enum appearance {
        light,
        dark,
    }

    /// A fenced code block to render.
    record fence-request {
        /// The language tag of the block, lowercased.
        language: string,
        /// The whole info string after the opening fence.
        info: string,
        /// The text between the fences.
        content: string,
        /// The appearance of the active theme.
        appearance: appearance,
        /// The path of the document, if it has one.
        path: option<string>,
    }

    /// The result of rendering a fenced code block.
    record fence-result {
        /// What to show in place of the block.
        output: fence-output,
        /// How many editor rows the output is expected to need. It only sizes
        /// the block until it has been laid out.
        height-hint: option<u32>,
    }

    /// The document an editor command runs on.
    record command-context {
        /// The whole text of the document.
        text: string,
        /// The selections, in UTF-8 byte offsets into `text`.
        selections: list<range>,
        /// The path of the document, if it has one.
        path: option<string>,
    }

    /// A replacement of a range of text.
    record text-edit {
        /// The range to replace, in the coordinates of the text the command ran
        /// on. Edits must not overlap.
        range: range,
        /// The text to put in its place.
        new-text: string,
    }

    /// What an editor command changes.
    record command-result {
        /// The edits to apply, all in the coordinates of the original text.
        edits: list<text-edit>,
        /// The selections to leave afterwards, in the coordinates of the text
        /// after the edits. Without them the editor keeps its own.
        selections: option<list<range>>,
        /// A message for the user.
        message: option<string>,
    }

    /// A piece of text that matched one of the extension's `dynamic` syntax rules.
    record rule-match {
        /// The matched text. For a rule that matches a syntax node, the node's text.
        text: string,
        /// The range of each capture group of the rule's pattern within `text`,
        /// group 0, the whole match, first. A group that took no part in the
        /// match is `none`. A rule that matches a syntax node has only group 0.
        captures: list<option<range>>,
    }

    /// Text to show in place of a range of a match.
    record replacement {
        /// The range to replace, in the coordinates of the matched text. It must
        /// not be empty and must not contain a line break.
        range: range,
        /// What to show instead. It must not contain a line break.
        text: string,
    }

    /// What a dynamic rule makes of one match. Every range is in UTF-8 bytes of
    /// that match's text, so the same output serves the same text wherever it
    /// appears in a document.
    record rule-output {
        /// Styles to apply.
        spans: list<styled-span>,
        /// Ranges to hide while the cursor is away from the match. They must not
        /// contain a line break.
        hidden: list<range>,
        /// Text to show in place of ranges while the cursor is away from the match.
        replacements: list<replacement>,
    }

    /// A heading of the document.
    record outline-heading {
        /// From 1 to 6.
        level: u8,
        /// The heading's text, without its markers.
        text: string,
        /// Where the heading is, in UTF-8 bytes of the document.
        range: range,
    }

    /// How a link was written.
    enum link-style {
        /// `[text](destination)`.
        inline,
        /// `[[name]]`.
        wikilink,
        /// `![[name]]`.
        embed,
    }

    /// A link or an embed in the document.
    record outline-link {
        style: link-style,
        /// The destination of an inline link as written, or the name inside the
        /// brackets of a wikilink or an embed.
        target: string,
        /// The text of an inline link.
        text: option<string>,
        /// Where the link is, in UTF-8 bytes of the document.
        range: range,
    }

    /// A `#tag` in the document.
    record outline-tag {
        /// The tag without the `#`.
        name: string,
        /// Where the tag is, in UTF-8 bytes of the document.
        range: range,
    }

    /// A task list item of the document.
    record outline-task {
        /// The item's text after its checkbox.
        text: string,
        checked: bool,
        /// Where the item's checkbox is, in UTF-8 bytes of the document.
        range: range,
    }

    /// The structure of a document.
    record outline {
        headings: list<outline-heading>,
        links: list<outline-link>,
        tags: list<outline-tag>,
        tasks: list<outline-task>,
        /// The front matter between the `---` lines the document starts with,
        /// if it does.
        frontmatter: option<string>,
    }

    /// What happened to a document.
    enum document-event-kind {
        /// The document is shown in an editor with live preview, and the extension
        /// has not been told yet. That includes documents that were already open
        /// when the extension loaded.
        opened,
        /// The document was saved.
        saved,
        /// The document was edited, and then left alone for the extension's
        /// `changed_debounce_ms`.
        changed,
    }

    /// Something that happened to a document.
    record document-event {
        kind: document-event-kind,
        /// The path of the document, if it has one.
        path: option<string>,
        /// The structure of the document as it is now.
        outline: outline,
    }

    /// A link the user is pointing at.
    record link-request {
        /// The scheme of an inline link's destination, lowercased, such as
        /// `sample` for `sample://x`. `none` for a wikilink, and for a
        /// destination without one.
        scheme: option<string>,
        /// The destination as written, or the name inside `[[` and `]]`.
        target: string,
        /// Whether this is a `[[wikilink]]`.
        wikilink: bool,
        /// The path of the document, if it has one.
        path: option<string>,
    }

    /// Where a link leads.
    variant link-target {
        /// An address to open.
        url(string),
        /// A file to open, as an absolute path or one relative to the document.
        file(string),
    }

    /// The user is completing the name of a wikilink.
    record completion-request {
        /// What the user has typed after `[[`.
        query: string,
        /// The path of the document, if it has one.
        path: option<string>,
        /// The Markdown files of the project, as paths relative to the project
        /// root, at most 2,000 of them.
        files: list<string>,
    }

    /// A suggested completion.
    record completion-item {
        /// What the menu shows.
        label: string,
        /// More about the item, shown beside it.
        detail: option<string>,
        /// What replaces what the user typed after `[[`.
        insert-text: string,
    }
}
